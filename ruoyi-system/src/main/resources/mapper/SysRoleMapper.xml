<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
    角色 Mapper XML
    对应接口：com.ruoyi.system.mapper.SysRoleMapper
    数据表：sys_role, sys_role_menu, sys_user_role

    包含以下 SQL 操作：
    - selectRoleList：条件查询角色列表
    - deleteRoleMenuByRoleIds：批量删除角色-菜单关联
    - insertRoleMenu：批量插入角色-菜单关联
    - selectRoleKeysByUserId：查询用户的角色标识列表
-->
<mapper namespace="com.ruoyi.system.mapper.SysRoleMapper">

    <!-- 角色表公共列 -->
    <sql id="roleColumns">
        role_id, role_name, role_key, role_sort, data_scope,
        menu_check_strictly, dept_check_strictly, status, del_flag,
        create_by, create_time, update_by, update_time, remark
    </sql>

    <!-- 条件查询角色列表（支持角色名/标识模糊、状态精确筛选） -->
    <select id="selectRoleList" resultType="com.ruoyi.system.domain.entity.SysRole">
        select <include refid="roleColumns"/>
        from sys_role
        <where>
            del_flag = '0'
            <if test="roleName != null and roleName != ''">
                and role_name like concat('%', #{roleName}, '%')
            </if>
            <if test="roleKey != null and roleKey != ''">
                and role_key like concat('%', #{roleKey}, '%')
            </if>
            <if test="status != null and status != ''">
                and status = #{status}
            </if>
        </where>
        order by role_sort
    </select>

    <!-- 批量删除角色-菜单关联（删除角色时先清关联） -->
    <delete id="deleteRoleMenuByRoleIds">
        delete from sys_role_menu where role_id in
        <foreach item="roleId" collection="array" open="(" separator="," close=")">
            #{roleId}
        </foreach>
    </delete>

    <!-- 批量删除用户-角色关联（删除角色时清理用户关联，防止脏数据） -->
    <delete id="deleteUserRoleByRoleIds">
        delete from sys_user_role where role_id in
        <foreach item="roleId" collection="array" open="(" separator="," close=")">
            #{roleId}
        </foreach>
    </delete>

    <!-- 批量插入角色-菜单关联（为角色分配多个菜单权限） -->
    <insert id="insertRoleMenu">
        insert into sys_role_menu (role_id, menu_id) values
        <foreach item="menuId" collection="menuIds" separator=",">
            (#{roleId}, #{menuId})
        </foreach>
    </insert>

    <!-- 查询用户的角色标识列表（通过 sys_user_role 关联） -->
    <select id="selectRoleKeysByUserId" resultType="String">
        select r.role_key
        from sys_role r
        inner join sys_user_role ur on r.role_id = ur.role_id
        where ur.user_id = #{userId} and r.status = '0' and r.del_flag = '0'
    </select>

</mapper>
